<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/gradient_background"
    tools:context=".MainActivityF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Custom Blue House with MRT Green Text Logo -->
        <RelativeLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp">

            <!-- Blue House Shape -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_blue_house"
                android:contentDescription="@string/app_logo" />

            <!-- Green MRT Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MRT"
                android:textColor="#4CAF50"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_centerInParent="true"/>
        </RelativeLayout>


        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Login"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="32dp"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <!-- White Card Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Email EditText with icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/edittext_background"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_email"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:tint="#6200EE" />

                    <EditText
                        android:id="@+id/edtEmailAddressLog"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Email Address"
                        android:inputType="textEmailAddress"
                        android:textSize="16sp"
                        android:background="@null"
                        android:padding="8dp"
                        android:layout_marginEnd="8dp" />
                </LinearLayout>

                <!-- Password EditText with icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/edittext_background"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_password"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:tint="#6200EE" />

                    <EditText
                        android:id="@+id/edtPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:textSize="16sp"
                        android:background="@null"
                        android:padding="8dp"
                        android:layout_marginEnd="8dp" />
                </LinearLayout>

                <!-- Login Button -->
                <Button
                    android:id="@+id/btnLoginLog"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Se connecter"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/button_gradient"
                    android:layout_marginBottom="12dp"
                    android:elevation="4dp"
                    android:stateListAnimator="@null" />

                <!-- Register Button -->
                <Button
                    android:id="@+id/btnRegisterLog"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="S'inscrire"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_gradient_secondary"
                    android:layout_marginBottom="12dp"
                    android:elevation="4dp"
                    android:stateListAnimator="@null" />

                <!-- Info TextView -->
                <TextView
                    android:id="@+id/txtDisplayInfLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#333333"
                    android:padding="12dp"
                    android:gravity="center"
                    android:visibility="gone"
                    android:textSize="14sp"
                    android:background="#F5F5F5"
                    android:layout_marginTop="8dp"
                    android:elevation="1dp"
                    android:drawableStart="@drawable/ic_info"
                android:drawablePadding="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Footer with company logo -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_company_logo"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/company_logo" />
    </LinearLayout>
</ScrollView>