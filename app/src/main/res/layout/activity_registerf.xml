<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/gradient_background"
    tools:context=".RegisterF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- App Logo -->


        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="32dp"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <!-- White Card Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Name Field with Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/edittext_background"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_person"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:tint="#6200EE" />

                    <EditText
                        android:id="@+id/edtFullnameReg"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Name"
                        android:inputType="text"
                        android:textSize="16sp"
                        android:background="@null"
                        android:padding="8dp" />
                </LinearLayout>

                <!-- Email Field with Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/edittext_background"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_email"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:tint="#6200EE" />

                    <EditText
                        android:id="@+id/edtEmailAddressReg"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Email Address"
                        android:inputType="textEmailAddress"
                        android:textSize="16sp"
                        android:background="@null"
                        android:padding="8dp" />
                </LinearLayout>

                <!-- Password Field with Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/edittext_background"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_password"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:tint="#6200EE" />

                    <EditText
                        android:id="@+id/edtPasswordReg"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:textSize="16sp"
                        android:background="@null"
                        android:padding="8dp" />
                </LinearLayout>

                <!-- Phone Field with Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/edittext_background"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_phone"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:tint="#6200EE" />

                    <EditText
                        android:id="@+id/edtPhonNumberReg"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Phone"
                        android:inputType="phone"
                        android:textSize="16sp"
                        android:background="@null"
                        android:padding="8dp" />
                </LinearLayout>

                <!-- Biography Field with Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/edittext_background"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_info"
                        android:layout_gravity="top"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:tint="#6200EE" />

                    <EditText
                        android:id="@+id/edtBioReg"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:hint="Biography"
                        android:inputType="textMultiLine"
                        android:textSize="16sp"
                        android:background="@null"
                        android:padding="8dp"
                        android:gravity="top" />
                </LinearLayout>

                <!-- Register Button -->
                <Button
                    android:id="@+id/btnRegisterReg"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="REGISTER"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/button_gradient"
                    android:layout_marginBottom="12dp"
                    android:elevation="4dp"
                    android:stateListAnimator="@null" />

                <!-- Login Button -->
                <Button
                    android:id="@+id/btnLoginReg"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="LOGIN"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_gradient_secondary"
                    android:elevation="4dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Footer with company logo -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_company_logo"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/company_logo" />
    </LinearLayout>
</ScrollView>